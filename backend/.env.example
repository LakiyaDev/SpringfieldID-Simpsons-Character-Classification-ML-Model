# =============================================================================
# Azure Custom Vision — SimpsonsML Project
# Copy to .env and fill in PREDICTION_KEY from simpsonsml-prediction resource
# =============================================================================

# --- Project (Custom Vision → Settings) ---
PROJECT_ID=0cd30418-ab7a-4911-bb0c-6e4057c9bea8
PUBLISHED_NAME=SimpsonMLIteration2
# ITERATION_ID=fc67c7c7-d766-4492-b5fb-8395775170d4

# --- Prediction resource (simpsonsml-prediction) — REQUIRED FOR BACKEND ---
CUSTOM_VISION_ENDPOINT=https://simpsonsml-prediction.cognitiveservices.azure.com
PREDICTION_KEY=4X9HLl6GKPa22lzyvrtuVNtGO2m0DQRjg0pnUtFCOKlVyilCi8dkJQQJ99CFACqBBLyXJ3w3AAAJACOGfGlQ
# PREDICTION_KEY_2=your_second_prediction_key_optional

# Prediction API (image file upload — what this app uses):
# POST https://simpsonsml-prediction.cognitiveservices.azure.com/customvision/v3.0/Prediction/0cd30418-ab7a-4911-bb0c-6e4057c9bea8/classify/iterations/SimpsonMLIteration2/image
# Headers: Prediction-Key, Content-Type: application/octet-stream

# Prediction API (image URL):
# POST https://simpsonsml-prediction.cognitiveservices.azure.com/customvision/v3.0/Prediction/0cd30418-ab7a-4911-bb0c-6e4057c9bea8/classify/iterations/SimpsonMLIteration2/url
# Headers: Prediction-Key, Content-Type: application/json
# Body: {"Url": "https://example.com/image.png"}

# --- Training resource (simpsonsml) — training only ---
# TRAINING_ENDPOINT=https://simpsonsml.cognitiveservices.azure.com
# TRAINING_KEY=your_training_key_from_simpsonsml

# --- Server ---
PORT=5001
FRONTEND_URL=http://localhost:3000
